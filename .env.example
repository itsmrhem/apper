# Cloudflare Browser Rendering — token needs "Browser Rendering - Edit"
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Session (pick one approach; structured cookies are best for Handshake)
# 1) Recommended: JSON file (array of {name, value, domain, path, ...}) — see secrets/*.example
HANDSHAKE_COOKIES_PATH=
# Markdown: canonical additional (professional) experience — copy from secrets/additional_experience.md.example
ADDITIONAL_EXPERIENCE_PATH=secrets/additional_experience.md
# Markdown: educational / campus roles — copy from secrets/educational_experience.md.example
EDUCATIONAL_EXPERIENCE_PATH=secrets/educational_experience.md
# Markdown: projects — copy from secrets/projects.md.example
PROJECTS_PATH=secrets/projects.md
# Markdown: contact, education, achievements — copy from secrets/resume_details.md.example
RESUME_DETAILS_PATH=secrets/resume_details.md
# LaTeX resume template (--application); copy from secrets/blueprint.tex.example
RESUME_BLUEPRINT_TEX_PATH=secrets/blueprint.tex
# 2) Quick: single Cookie header string (harder with many/large cookies)
HANDSHAKE_COOKIE=

# Optional: Cloudflare /json custom AI model for job detail extraction
# Example model: anthropic/claude-sonnet-4-20250514
# JOB_DETAIL_CUSTOM_AI_MODEL=
# JOB_DETAIL_CUSTOM_AI_AUTHORIZATION=Bearer <PROVIDER_API_KEY>

# LangSmith (LangGraph / LangChain tracing) — https://docs.smith.langchain.com/
# Use either LANGCHAIN_* or LANGSMITH_* names for the API key / project.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=apper
# LANGCHAIN_ENDPOINT=   # optional, e.g. EU: https://eu.api.smith.langchain.com

# Job application pipeline (--application): Anthropic for LaTeX, pdflatex for PDFs
# ANTHROPIC_API_KEY=
# ANTHROPIC_RESUME_MODEL=claude-sonnet-4-20250514
# PDFLATEX_PATH=pdflatex
