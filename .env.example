# Cloudflare Browser Rendering — token needs "Browser Rendering - Edit"
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Session (pick one approach; structured cookies are best for Handshake)
# 1) Recommended: JSON file (array of {name, value, domain, path, ...}) — see secrets/*.example
HANDSHAKE_COOKIES_PATH=
# 2) Quick: single Cookie header string (harder with many/large cookies)
HANDSHAKE_COOKIE=

# LangSmith (LangGraph / LangChain tracing) — https://docs.smith.langchain.com/
# Use either LANGCHAIN_* or LANGSMITH_* names for the API key / project.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=apper
# LANGCHAIN_ENDPOINT=   # optional, e.g. EU: https://eu.api.smith.langchain.com
